CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Dual app slots with legacy NVS offsets preserved across USB migration.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# app_main synchronously recovers NVS zone/trigger journals and initializes
# the SPI status LED plus BLE/Wi-Fi. ESP-IDF's default main-task stack is
# insufficient on the tested ESP32-S3 (bootloop after GPIO48 SPI init).
# Reserve startup headroom; renderer and sampler task stacks stay unchanged.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# ESP32-S3 N16R8: 16 MB flash, 8 MB octal PSRAM. Make PSRAM
# available to normal heap allocations so radio/HTTP buffers do not consume
# all internal RAM reserved for FreeRTOS task stacks and RMT/DMA needs.
# Task stacks themselves MUST remain internal (flash/NVS cache-off safety).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
# Prefer PSRAM for non-DMA malloc buffers >1KB rather than retaining
# nearly 8MB idle while controller HCI is short on INTERNAL/8BIT heap.
# Capability-qualified INTERNAL/DMA allocations and FreeRTOS stacks are
# unaffected; the 32KB protected internal DMA/IRAM pool remains reserved.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# SoftAP is a secondary diagnostic/Studio transport (max 2 clients), not
# a throughput benchmark. Match the RX BA window to static RX buffers.
# Retain AMPDU reception, full Wi-Fi/HTTP and OTA; bound per-session
# internal DMA buffer demand so BLE HCI and the 8KB safety renderer coexist.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# Low-IRAM, low-DMA secondary 2-client Wi-Fi; BLE and RMT remain active.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_FREERTOS_PLACE_TASK_STACKS_IN_EXT_RAM=n

# BLE show and output manager over authorized GATT, Wi-Fi remains full Studio transport
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Issue #113: one ESP32-S3, task/interrupt/boot watchdog. Enable panic-reset
# behaviour instead of ESP-IDF's warning-only TWDT default. Keep both CPU idle
# tasks monitored so scheduler starvation is detected independently of users.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_BOOTLOADER_WDT_ENABLE=y
CONFIG_BOOTLOADER_WDT_TIME_MS=9000
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_BOOTLOADER_WDT_DISABLE_IN_USER_CODE=n
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
